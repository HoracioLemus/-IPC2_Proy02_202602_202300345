@{
    ViewData["Title"] = "Catálogo";
}

<h1>Catálogo de Libros</h1>

<ul class="nav nav-tabs" id="catalogoTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="config-tab" data-bs-toggle="tab" data-bs-target="#config" type="button" role="tab">Configuración</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="estructura-tab" data-bs-toggle="tab" data-bs-target="#estructura" type="button" role="tab">Estructura y Categorías</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="libros-tab" data-bs-toggle="tab" data-bs-target="#libros" type="button" role="tab">Gestión de Libros</button>
    </li>
</ul>

<div class="tab-content border border-top-0 p-3" id="catalogoTabsContent">

    <!-- PESTAÑA A: Configuración -->
    <div class="tab-pane fade show active" id="config" role="tabpanel">
        <h2>Cargar Archivo XML</h2>
        <form asp-action="CargarXmlDesdeArchivo" method="post" enctype="multipart/form-data">
            <input type="file" name="archivoXML" accept="*/*.xml" required />
            <button type="submit" class="btn btn-primary">Cargar</button>
        </form>

        @if (ViewBag.ErrorCarga != null)
        {
            <p style="color:red">@ViewBag.ErrorCarga</p>
        }
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var pestanaServidor = "@ViewBag.PestanaActiva";
        var pestanaAMostrar = pestanaServidor !== "" ? pestanaServidor : sessionStorage.getItem('pestanaActivaCatalogo');

        if (pestanaAMostrar) {
            var boton = document.querySelector('[data-bs-target="' + pestanaAMostrar + '"]');
            if (boton) {
                var tab = new bootstrap.Tab(boton);
                tab.show();
            }
        }

        var botones = document.querySelectorAll('#catalogoTabs button');
        botones.forEach(function (boton) {
            boton.addEventListener('shown.bs.tab', function (evento) {
                sessionStorage.setItem('pestanaActivaCatalogo', evento.target.getAttribute('data-bs-target'));
            });
        });
    });
</script>

    <!-- PESTAÑA B: Estructura y Categorías -->
    <div class="tab-pane fade" id="estructura" role="tabpanel">
        <div class="row">
            <div class="col-md-6">
                <h2>Estructura del Catálogo</h2>
                <div style="max-height: 500px; overflow-y: auto; border: 1px solid #ccc; padding: 10px;">
                    @Html.Raw(ViewBag.JerarquiaHtml)
                </div>
            </div>
            <div class="col-md-6">
                <h2>Agregar Categoría</h2>
                <form asp-action="AgregarCategoria" method="post">
                    <label>Nombre:</label>
                    <input type="text" name="nombre" required />
                    <label>Padre (opcional):</label>
                    <input type="text" name="padre" />
                    <button type="submit" class="btn btn-primary">Agregar</button>
                </form>
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="col-12">
                <h2>Ver Gráfico de una categoría</h2>
                <form asp-action="GenerarGrafico" method="post">
                    <label>Nombre de categoria:</label>
                    <input type="text" name="categoria" required />
                    <button type="submit" class="btn btn-primary">Generar Gráfico</button>
                </form>

                @if (ViewBag.ErrorGrafico != null)
                {
                    <p style="color:red">@ViewBag.ErrorGrafico</p>
                }

                @if (ViewBag.RutaImagen != null)
                {
                    <div style="overflow-x: auto; max-width: 100%; border: 1px solid #ccc; margin-top: 10px;">
                        <img src="@ViewBag.RutaImagen" alt="Gráfico de categoria" style="max-height: 500px;" />
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- PESTAÑA C: Gestión de Libros -->
    <div class="tab-pane fade" id="libros" role="tabpanel">
        <div class="row row-cols-1 row-cols-md-2 g-3">
            <div class="col">
                <div class="card p-3 h-100">
                    <h2>Registrar nuevo libro</h2>
                    <form asp-action="RegistrarLibro" method="post">
                        <div><label>ISBN:</label><input type="number" name="isbn" required /></div>
                        <div><label>Título:</label><input type="text" name="titulo" required /></div>
                        <div><label>Autor:</label><input type="text" name="autor" required /></div>
                        <div><label>Categoría:</label><input type="text" name="categoria" required /></div>
                        <button type="submit" class="btn btn-primary mt-2">Registrar</button>
                    </form>
                </div>
            </div>

            <div class="col">
                <div class="card p-3 h-100">
                    <h2>Buscar libro por ISBN</h2>
                    <form asp-action="BuscarPorIsbn" method="post">
                        <label>ISBN:</label>
                        <input type="number" name="isbn" required />
                        <button type="submit" class="btn btn-primary">Buscar</button>
                    </form>

                    @if (ViewBag.LibroEncontrado != null)
                    {
                        var libro = ViewBag.LibroEncontrado as CatalogoLibreria.Models.Libro;
                        <p><strong>@libro.Titulo</strong> - @libro.Autor (ISBN: @libro.ISBN)</p>
                    }
                    else if (ViewBag.LibroEncontrado == null && Context.Request.Method == "POST" && Context.Request.Path.Value.Contains("BuscarPorIsbn"))
                    {
                        <p>Libro no encontrado.</p>
                    }
                </div>
            </div>

            <div class="col">
                <div class="card p-3 h-100">
                    <h2>Libro con menor y mayor ISBN</h2>
                    <a asp-action="VerMinMax" class="btn btn-secondary">Ver</a>

                    @if (ViewBag.LibroMin != null)
                    {
                        var min = ViewBag.LibroMin as CatalogoLibreria.Models.Libro;
                        var max = ViewBag.LibroMax as CatalogoLibreria.Models.Libro;
                        <p class="mt-2">Menor ISBN: <strong>@min.Titulo</strong> (ISBN: @min.ISBN)</p>
                        <p>Mayor ISBN: <strong>@max.Titulo</strong> (ISBN: @max.ISBN)</p>
                    }
                </div>
            </div>

            <div class="col">
                <div class="card p-3 h-100">
                    <h2>Eliminar libro</h2>
                    <form asp-action="EliminarLibro" method="post">
                        <label>ISBN:</label>
                        <input type="number" name="isbn" required />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>