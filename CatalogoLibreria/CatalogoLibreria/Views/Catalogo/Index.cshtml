@{
    ViewData["Title"] = "Catálogo";
}

<h1>Catálogo de Libros</h1>

<div>
    @Html.Raw(ViewBag.JerarquiaHtml)
</div>

<hr />
<h2>Registrar nuevo libro</h2>

<form asp-action="RegistrarLibro" method="post">
    <div>
        <label>ISBN:</label>
        <input type="number" name="isbn" required />
    </div>
    <div>
        <label>Titulo:</label>
        <input type="text" name="titulo" requiered />
    </div>
    <div>
        <label>Autor:</label>
        <input type="text" name="autor" requiered />
    </div>
    <div>
        <label>Categoria:</label>
        <input type="text" name="categoria" requiered />
    </div>
    <button type="submit">Registrar</button>
</form>

<hr />
<h2>Ver Gráfico de una categoría</h2>

<form asp-action="GenerarGrafico" method="post">
    <label>Nombre de categoria:</label>
    <input type="text" name="categoria" requiered />
    <button type="submit">Generar Gráfico</button>
</form>

@if (ViewBag.ErrorGrafico != null)
{
    <p style="color:red">@ViewBag.ErrorGraphico</p>
}

@if (ViewBag.RutaImagen != null)
{
    <img src="@ViewBag.RutaImagen" alt="Gráfico de categoria" />
}

<hr />
<h2>Buscar libro por ISBN</h2>

<form asp-action="BuscarPorIsbn" method="post">
    <label>ISBN:</label>
    <input type="number" name="isbn" requiered />
    <button type="submit">Buscar</button>
</form>

@if (ViewBag.LibroEncontrado != null)
{
    var libro = ViewBag.LibroEncontrado as CatalogoLibreria.Models.Libro;
    <p><strong>@libro.Titulo</strong> - @libro.Autor (ISBN: @libro.ISBN)</p>
}
else if (ViewBag.LibroEncontrado == null && Context.Request.Method == "POST" && Context.Request.Path.Value.Contains("BuscarPorIsbn"))
{
    <p>Libro no encontrado.</p>
}

<hr />
<h2>Libro con menor y mayor ISBN</h2>
<a asp-action="VerMinMax">Ver</a>

@if (ViewBag.LibroMin != null)
{
    var min = ViewBag.LibroMin as CatalogoLibreria.Models.Libro;
    var max = ViewBag.LibroMax as CatalogoLibreria.Models.Libro;
    <p>Menor ISBN: <strong>@min.Titulo</strong> (ISBN: @min.ISBN)</p>
    <p>Mayor ISBN: <strong>@max.Titulo</strong> (ISBN: @max.ISBN)</p>
}